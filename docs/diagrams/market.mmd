---
config:
  layout: elk
  theme: base
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "15px"
    primaryTextColor: "#203040"
    lineColor: "#475569"
    edgeLabelBackground: "#ffffff"
  flowchart:
    htmlLabels: false
    nodeSpacing: 25
    rankSpacing: 45
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
    mergeEdges: false
---
flowchart TB
    subgraph Trust[Choose root authority]
      O[Own anchor]:::anchor -->|Local roots| T[Terminal policy]:::terminal
      I[Institutional anchors]:::anchor -->|Signed roots| T
    end
    subgraph Market[Buy service capacity]
      B[Application operator]:::app -.->|Availability agreement| P[Data + proof provider]:::ledger
    end
    T -->|Accepted commitment| V[Terminal verification]:::terminal
    P -->|Data + evidence| V
    V -->|Verified claims| E[Transactions or effects]:::terminal
    style Trust fill:#f5fbf8,stroke:#2c7155
    style Market fill:#f5f8fd,stroke:#416dad

    classDef anchor fill:#e1f3eb,stroke:#2c7155,stroke-width:1.5px,color:#163d2e
    classDef ledger fill:#e6effc,stroke:#416dad,stroke-width:1.5px,color:#203a63
    classDef app fill:#fff0dd,stroke:#a46b25,stroke-width:1.5px,color:#644317
    classDef terminal fill:#eee8fa,stroke:#7856a8,stroke-width:1.5px,color:#463064
    classDef neutral fill:#f3f4f6,stroke:#687384,stroke-width:1.5px,color:#293342
