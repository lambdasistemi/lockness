---
config:
  layout: elk
  theme: base
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "15px"
    primaryTextColor: "#203040"
    lineColor: "#475569"
    edgeLabelBackground: "#ffffff"
  flowchart:
    htmlLabels: false
    nodeSpacing: 25
    rankSpacing: 45
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
    mergeEdges: false
---
flowchart TB
    subgraph A[Anchor infrastructure]
      N[Anchor node]:::anchor -->|Validated blocks| R[Commitment engine]:::anchor
    end
    subgraph B[Provider infrastructure]
      M[Provider node]:::ledger -->|Validated blocks| L[Ledger service]:::ledger
    end
    R -->|Signed roots| T[Terminal verification]:::terminal
    L -->|Data + proofs| T
    L -->|History| P[Application builder]:::app
    P -->|Application proofs| T
    style A fill:#f5fbf8,stroke:#2c7155
    style B fill:#f5f8fd,stroke:#416dad

    classDef anchor fill:#e1f3eb,stroke:#2c7155,stroke-width:1.5px,color:#163d2e
    classDef ledger fill:#e6effc,stroke:#416dad,stroke-width:1.5px,color:#203a63
    classDef app fill:#fff0dd,stroke:#a46b25,stroke-width:1.5px,color:#644317
    classDef terminal fill:#eee8fa,stroke:#7856a8,stroke-width:1.5px,color:#463064
    classDef neutral fill:#f3f4f6,stroke:#687384,stroke-width:1.5px,color:#293342
