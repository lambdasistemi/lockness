---
config:
  theme: base
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "15px"
    actorBkg: "#ffffff"
    actorBorder: "#475569"
    actorTextColor: "#203040"
    signalColor: "#475569"
    signalTextColor: "#203040"
  sequence:
    actorMargin: 15
    messageMargin: 30
    mirrorActors: false
    width: 100
    actorFontSize: 15
    messageFontSize: 15
    noteFontSize: 15
    wrap: true
    useMaxWidth: false
---
sequenceDiagram
    box rgb(225,243,235) Root authority
      participant A as Anchor
    end
    box rgb(238,232,250) Verification
      participant T as Terminal
    end
    box rgb(230,239,252) Ledger data
      participant L as Ledger provider
    end
    box rgb(255,240,221) Application
      participant B as Proof builder
    end
    A->>T: Signed root stream
    T->>L: Discover retained views<br/>and coverage
    L-->>T: Available chainpoints
    T->>T: Select accepted and<br/>available chainpoint P
    T->>L: Acquire P
    L-->>T: Session for P or refusal
    Note over T,L: Continue only after acquisition
    T->>L: Read NFT under session
    L-->>T: Output + ledger witness
    T->>T: Verify NFT output
    T->>B: Request proof for<br/>verified application root
    B->>L: History at P
    L-->>B: CBOR + references
    B->>B: Reconstruct state
    B-->>T: Application proof
    T->>T: Verify before use
